# --- Line Endings ---
* text=auto

# Enforce LF for C++, GDScript, build scripts, and manifests
*.cpp text eol=lf
*.hpp text eol=lf
*.c text eol=lf
*.h text eol=lf
*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.gdextension text eol=lf
*.godot text eol=lf
*.json text eol=lf
*.md text eol=lf
SConstruct text eol=lf
SConscript text eol=lf
CMakeLists.txt text eol=lf
*.cmake text eol=lf
*.sh text eol=lf

# Enforce CRLF for Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# --- Git LFS (Optional: if committing pre-compiled binaries or test assets) ---
*.dll filter=lfs diff=lfs merge=lfs -text
*.so filter=lfs diff=lfs merge=lfs -text
*.dylib filter=lfs diff=lfs merge=lfs -text
*.a filter=lfs diff=lfs merge=lfs -text
*.lib filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
