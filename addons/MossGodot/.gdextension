[configuration]

entry_symbol = "MossGodot"
compatibility_minimum = "4.7"
reloadable = false


[libraries]

windows.debug.x86_64 = "res://addons/moss_godot/bin/moss_godot.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/moss_godot/bin/moss_godot.windows.template_release.x86_64.dll"

linux.debug.x86_64 = "res://addons/moss_godot/bin/libmoss_godot.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/moss_godot/bin/libmoss_godot.linux.template_release.x86_64.so"

macos.debug = "res://addons/moss_godot/bin/libmoss_godot.macos.template_debug.universal.dylib"
macos.release = "res://addons/moss_godot/bin/libmoss_godot.macos.template_release.universal.dylib"
